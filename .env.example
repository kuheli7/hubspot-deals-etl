# HubSpot Deals ETL - environment template
# Copy to .env (git-ignored) and adjust. docker-compose reads the HubSpot
# settings below from .env; the database values match the dev containers.

# ---------------------------------------------------------------------------
# Flask
# ---------------------------------------------------------------------------
FLASK_ENV=development
FLASK_DEBUG=true
SECRET_KEY=dev-secret-key-change-in-production
HOST=0.0.0.0
PORT=5200

# Password used to encrypt access tokens stored with each scan job
CONFIG_PASSWORD=dev-config-password-change-me

# ---------------------------------------------------------------------------
# Database (development credentials - matches postgres_dev in docker-compose)
# ---------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=hubspot_deals_data_dev
DB_USER=postgres
DB_PASSWORD=password123
DB_SCHEMA=hubspot_deals_dev

# ---------------------------------------------------------------------------
# DLT pipeline
# ---------------------------------------------------------------------------
DLT_PIPELINE_NAME=hubspot_deals_pipeline_dev
DLT_WORKING_DIR=.dlt

# ---------------------------------------------------------------------------
# HubSpot CRM API
# ---------------------------------------------------------------------------
HUBSPOT_API_BASE_URL=https://api.hubapi.com
HUBSPOT_API_TIMEOUT=30
# Client-side burst limit: requests per rolling window (HubSpot: 150 / 10 s)
HUBSPOT_RATE_LIMIT_MAX_REQUESTS=150
HUBSPOT_RATE_LIMIT_WINDOW_SECONDS=10
HUBSPOT_RETRY_ATTEMPTS=3
# Deals per page (max 100) and checkpoint frequency in pages
HUBSPOT_PAGE_SIZE=100
HUBSPOT_CHECKPOINT_INTERVAL_PAGES=10
# Testing aid: sleep between pages so a scan can be paused mid-run (0 = off)
HUBSPOT_PAGE_DELAY_SECONDS=0

# Private app access token - used ONLY by the helper scripts in scripts/
# (create_test_deals.py, run_extraction_test.py). The service itself receives
# the token in each scan request. Never commit a real token.
HUBSPOT_ACCESS_TOKEN=pat-na1-your-token-here

# ---------------------------------------------------------------------------
# Service limits
# ---------------------------------------------------------------------------
MAX_CONCURRENT_SCANS=3
SCAN_TIMEOUT_HOURS=24
CLEANUP_DAYS=7

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
LOG_LEVEL=INFO
LOKI_ENABLED=false
LOKI_URL=http://localhost:3100
LOKI_USERNAME=
LOKI_PASSWORD=
